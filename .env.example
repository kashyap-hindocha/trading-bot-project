COINDCX_API_KEY=your_api_key_here
COINDCX_API_SECRET=your_api_secret_here
PAPER_TRADING_BALANCE=10000
DEFAULT_LEVERAGE=5
MAX_POSITION_SIZE_BTC=0.5
DAILY_LOSS_LIMIT=500
MAX_OPEN_POSITIONS=3
MIN_TIME_BETWEEN_TRADES_SEC=10
LOG_LEVEL=INFO
SLIPPAGE_PERCENT=0.05
WEB_PORT=8000
DATABASE_URL=sqlite:///data/trading.db
DEFAULT_ORDER_QUANTITY=0.001
AUTO_TRADE_ENABLED=true
# OHLC: CoinDCX public candles are often stale. auto uses Binance for the active pair when needed.
# Values: auto | binance | coindcx
OHLC_SOURCE=auto
COINDCX_MAX_CANDLE_AGE_SEC=180
